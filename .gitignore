# Ignore environment variables file
**/.env
backups/*.sql
# ----------------------------------------------------------------
# IGNORING COMPOSER/VENDOR FILES IN PLUGINS
# ----------------------------------------------------------------

# Ignore vendor directories (dependencies) in specific plugins
wp-backend/wp-backend/wp-content/plugins/*/vendor/
wp-backend/wp-backend/wp-content/plugins/*/composer.lock
wp-content/uploads
# Ignore WordPress uploads
wp-backend/wp-backend/wp-content/uploads/

# Ignore temporary or backup files
wp-backend/wp-backend/wp-content/upgrade-temp-backup/
# Ignore all plugins, uploads, and backups
wp-backend/wp-backend/wp-content/plugins/
wp-backend/wp-backend/wp-content/uploads/
wp-backend/wp-backend/wp-content/upgrade-temp-backup/


# Specific exception for the WooCommerce/Stripe plugins listed
wp-backend/wp-backend/wp-content/plugins/stripe-checkout/composer.lock
wp-backend/wp-backend/wp-content/plugins/woocommerce/vendor/
# Ignore all plugin changes
wp-backend/wp-backend/wp-content/plugins/


# ----------------------------------------------------------------
# PREVIOUSLY IGNORED (to ensure they are still there)
# ----------------------------------------------------------------
# You might want to keep the asset-specific one if you didn't use the vendor/ wildcard:
 wp-backend/wp-backend/wp-content/plugins/woocommerce/assets/client/


# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
